/ Track card - blind or revealed (playback-host: preview vs Spotify handoff + resume UX)
- refresh_preview = (!track.preview_url_valid? ? refresh_track_preview_path(track.token) : nil)
.bg-slate-800.rounded-2xl.overflow-hidden.relative(
  data-controller="playback-host"
  data-playback-host-resolve-url-value=track_playback_path(track.token)
  data-playback-host-game-id-value=game.id.to_s
  data-playback-host-loading-track-value=t("games.track_card.playback.loading_track")
  data-playback-host-loading-preview-value=t("games.track_card.playback.loading_preview")
  data-playback-host-opening-spotify-value=t("games.track_card.playback.opening_spotify")
  data-playback-host-external-hint-value=t("games.track_card.playback.external_hint")
  data-playback-host-error-resolve-value=t("games.track_card.playback.error_resolve")
  data-playback-host-error-preview-value=t("games.track_card.playback.error_preview")
  data-playback-host-error-network-value=t("games.track_card.playback.error_network")
  data-playback-host-error-spotify-value=t("games.track_card.playback.error_spotify")
  data-playback-host-resume-message-value=t("games.track_card.playback.resume_message")
  data-playback-host-manual-hint-value=t("games.track_card.playback.manual_hint")
)
  / Full-card loading / handoff overlay
  .hidden.absolute.inset-0.z-30.flex.items-center.justify-center.bg-slate-950/95.rounded-2xl.p-6 data-playback-host-target="transitionOverlay"
    .max-w-sm.text-center.space-y-3
      p.text-white.font-semibold data-playback-host-target="transitionMessage"
      p.text-slate-400.text-sm.leading-relaxed data-playback-host-target="transitionHint"

  / Resume banner after returning from Spotify
  .hidden.absolute.top-0.left-0.right-0.z-20.p-4.bg-emerald-950/95.border-b.border-emerald-700/50.rounded-t-2xl data-playback-host-target="resumeBanner"
    .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-3
      p.text-emerald-100.text-sm.flex-1 data-playback-host-target="resumeMessage"
      .flex.gap-2
        button.text-sm.font-medium.px-3.py-1.5.rounded-lg.bg-emerald-700.text-white.hover:bg-emerald-600 type="button" data-action="click->playback-host#dismissResume"
          = t("games.track_card.playback.dismiss_resume")

  .aspect-video.relative.bg-slate-800
    - if revealed && track&.album_cover_url.present?
      img src=track.album_cover_url alt="" class="w-full h-full object-cover" onerror="this.remove()"
    - else
      .w-full.h-full.flex.flex-col.items-center.justify-center.gap-4
        .w-24.h-24.rounded-full.bg-slate-600/50.flex.items-center.justify-center
          = icon("music", class: "w-12 h-12 text-slate-400")

    .absolute.bottom-0.left-0.right-0.h-16.bg-slate-900/70

  .p-6
    .hidden.mb-4.p-3.rounded-xl.bg-red-950/40.border.border-red-800/50 data-playback-host-target="errorPanel"
      p.text-red-200.text-sm data-playback-host-target="errorMessage"

    - if revealed
      .text-center.mb-6
        h2.text-2xl.font-bold.text-white.mb-2= track&.title || "Unknown Title"
        p.text-lg.text-slate-300= track&.artist_name || "Unknown Artist"
        - if track&.album_name.present?
          p.text-sm.text-slate-500.mt-1= track.album_name
        - if track&.release_year.present?
          p.text-sm.text-purple-400.mt-2= track.release_year
    - else
      .text-center.mb-4
        h2.text-2xl.font-bold.text-slate-400= presenter.mystery_text
        p.text-slate-500= presenter.mystery_hint

    .flex.flex-col.gap-3.mb-6
      button.w-full.py-3.rounded-xl.bg-green-600.hover:bg-green-500.text-white.font-semibold.transition-colors.inline-flex.items-center.justify-center.gap-2(
        type="button"
        data-playback-host-target="listenButton"
        data-action="click->playback-host#startListening"
      )
        = icon("player-play", class: "w-5 h-5")
        span= t("games.track_card.playback.listen_round")
      button.w-full.py-2.5.rounded-xl.border.border-slate-600.text-slate-300.hover:bg-slate-700.text-sm.font-medium(
        type="button"
        data-playback-host-target="externalOnlyButton"
        data-action="click->playback-host#openExternalOnly"
      )
        = t("games.track_card.playback.open_spotify_only")

    - if track&.preview_url.present? || !track&.preview_url_valid?
      .mb-6 data-controller="audio-player" data-audio-player-refresh-url-value=refresh_preview
        audio data-audio-player-target="audio" data-playback-host-target="previewAudio" preload="auto"
          - if track.preview_url_valid?
            source src=track_preview_stream_path(track.token) type="audio/mpeg"

        .flex.justify-center.mb-4
          button.w-16.h-16.rounded-full.bg-purple-600.hover:bg-purple-500.text-white.flex.items-center.justify-center.transition-colors(
            type="button"
            data-action="click->audio-player#toggle"
            data-audio-player-target="playButton"
          )
            span data-audio-player-target="playIcon"
              = icon("player-play", class: "w-8 h-8 ml-0.5")
            span.hidden data-audio-player-target="pauseIcon"
              = icon("player-pause", class: "w-8 h-8")

        .px-2
          .h-2.bg-slate-700.rounded-full.cursor-pointer.overflow-hidden data-action="click->audio-player#seek" data-audio-player-target="progressBar"
            .h-full.bg-purple-500.rounded-full data-audio-player-target="progress" style="width: 0%"
          .flex.justify-between.text-xs.text-slate-500.mt-2
            span data-audio-player-target="currentTime" 0:00
            span data-audio-player-target="duration" 0:30
        p.text-center.text-xs.text-slate-500.mt-2= t("games.track_card.playback.manual_controls_hint")
    - else
      .text-center.py-4.mb-4
        = icon("music-off", class: "w-10 h-10 text-slate-600 mx-auto mb-2")
        p.text-slate-500.text-sm= presenter.no_preview_message

    .grid.grid-cols-2.gap-3.mt-6
      - if revealed
        .col-span-2
          = button_to next_track_game_path(game), method: :post, class: "w-full py-4 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-xl inline-flex items-center justify-center gap-2 transition-colors" do
            span= presenter.next_button_label
            = icon("arrow-right", class: "w-5 h-5")
      - else
        = button_to reveal_game_path(game), method: :post, class: "w-full py-4 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded-xl inline-flex items-center justify-center gap-2 transition-colors" do
          = icon("eye", class: "w-5 h-5")
          span= presenter.reveal_button_label

        = button_to next_track_game_path(game), method: :post, class: "w-full py-4 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-xl inline-flex items-center justify-center gap-2 transition-colors" do
          span= presenter.skip_button_label
          = icon("arrow-right", class: "w-5 h-5")
