div id="game-progress" class="mb-8"
  .h-2.bg-slate-700.rounded-full.overflow-hidden
    .h-full.bg-purple-600.transition-[width].duration-300.ease-out style="width: #{presenter.progress_percentage}%"
  .flex.justify-between.text-xs.text-slate-500.mt-2
    span= presenter.progress_label
    span= presenter.remaining_label
