- content_for :title, show_presenter.page_title

= turbo_stream_from "room_#{@room.id}"

.max-w-2xl.mx-auto.px-4.py-8
  .flex.items-center.justify-between.mb-6
    = link_to root_path, class: "flex items-center gap-2 text-slate-400 hover:text-white transition-colors" do
      = icon("arrow-left", class: "w-5 h-5")
      span= show_presenter.back_label

    .flex.items-center.gap-3
      span.font-mono.text-lg.font-bold.text-white.bg-slate-700.px-4.py-2.rounded-lg= show_presenter.decorated_object.display_code
      button type="button" class="px-3 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 text-sm inline-flex items-center gap-1" data-controller="clipboard" data-clipboard-text-value=room_share_full_url(@room) data-clipboard-success-message-value=show_presenter.copied_label data-clipboard-label-value=show_presenter.share_label data-action="click->clipboard#copy"
        = icon("link", class: "w-4 h-4")
        span data-clipboard-target="label"
          = show_presenter.share_label

  - if show_presenter.host?
    .flex.flex-wrap.gap-3.mb-6
      = button_to room_reveal_actions_path(@room), method: :post, class: "inline-flex items-center gap-2 px-4 py-3 bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-xl transition-colors", disabled: @room.current_track.blank?
        = icon("eye", class: "w-5 h-5")
        span= show_presenter.reveal_label
      = button_to room_next_actions_path(@room), method: :post, class: "inline-flex items-center gap-2 px-4 py-3 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-xl transition-colors" do
        = icon("arrow-right", class: "w-5 h-5")
        span= show_presenter.next_label

  = render "rooms/room_player", room: @room
