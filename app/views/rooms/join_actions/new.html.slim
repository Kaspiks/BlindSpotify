- content_for :title, t("controllers.rooms.join_actions.new.page_title", default: "Join room")

.max-w-md.mx-auto.px-4.py-12
  .bg-slate-800.rounded-2xl.p-8
    h1.text-2xl.font-bold.text-white.mb-2= t("controllers.rooms.join_actions.new.title", default: "Join the game")
    - if current_user.present?
      p.text-slate-400.mb-2= t("controllers.rooms.join_actions.new.description_signed_in", default: "Confirm or edit the name others will see, then join.")
    - else
      p.text-slate-400.mb-2= t("controllers.rooms.join_actions.new.description", default: "Enter your name to join this room.")
    p.font-mono.text-lg.font-semibold.text-purple-400.mb-6= @room.code

    = form_with scope: :rooms_join_action, url: room_join_submit_path(@room.code), method: :post, local: true, html: { class: "space-y-4" } do |f|
      = f.text_field :name, value: (@name.presence || @prefill_display_name), placeholder: t("controllers.rooms.join_actions.new.name_placeholder", default: "e.g. Alex"), class: "w-full px-4 py-3 rounded-xl bg-slate-700 border border-slate-600 text-white placeholder-slate-500 focus:ring-2 focus:ring-purple-500 focus:border-transparent", required: !current_user.present?, autofocus: true
      = f.submit t("controllers.rooms.join_actions.new.submit", default: "Join"), class: "w-full py-4 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-xl cursor-pointer"

    .mt-6.text-center
      = link_to root_path, class: "text-slate-400 hover:text-white transition-colors" do
        = icon("arrow-left", class: "w-5 h-5 inline mr-2")
        span= t("controllers.rooms.join_actions.new.back", default: "Back")
